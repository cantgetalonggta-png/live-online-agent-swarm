# ── Policy (non-secret) ──
HITL_REQUIRED=true
PUBLIC_RECORD_CEILING=true
LOG_LEVEL=INFO
SWARM_ENV=dev

# ── Swarm API auth (set to enable; empty = open dev mode) ──
SWARM_API_KEY=
SWARM_API_KEY_READ=
SWARM_CORS_ORIGINS=*

# ── Durable memory ──
REDIS_URL=
# NEO4J_URI=
# NEO4J_USER=
# NEO4J_PASSWORD=

# ── Public search ──
TAVILY_API_KEY=

# ── LLM providers (any one enables /llm/complete + Synthesizer) ──
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GROK_API_KEY=
GROQ_API_KEY=
LLM_PRIMARY=anthropic
LLM_FALLBACK=groq
# OPENAI_MODEL=gpt-4o-mini
# ANTHROPIC_MODEL=claude-3-5-haiku-latest
# GROQ_MODEL=llama-3.1-8b-instant
# GROK_MODEL=grok-2-latest

# Never commit real secrets. Keep Stripe/payment keys out of this process entirely.
